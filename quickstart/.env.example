# Copy to .env beside docker-compose.yaml (cp ../.env.example .env).
# On Linux set AIRFLOW_UID to the output of `id -u`, so ./logs and ./rivet-state are owned by you.
AIRFLOW_UID=50000
# Host ports, all bound to 127.0.0.1.
AIRFLOW_PORT=8080
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_PORT=8123
# Set before Connections hold real passwords: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
